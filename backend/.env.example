# Comma-separated list of allowed frontend origins for CORS.
# Set this to your real Vercel domain in production, e.g.:
# SEGMENTIQ_ALLOWED_ORIGINS=https://segmentiq-ai.vercel.app
SEGMENTIQ_ALLOWED_ORIGINS=*

# Optional override for the SQLite database file location.
# SEGMENTIQ_DB_PATH=/app/data/segmentiq.db
